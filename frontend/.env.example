# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# These values are baked in at build time, so re-run `npm run build` after edits.
#
# Local development: point directly at the Node runtimes.
VITE_RUNTIME_API_BASE=http://localhost:19090
VITE_LEAN_API_BASE=http://localhost:19100

# Production behind Nginx: use the reverse-proxy paths instead.
# VITE_RUNTIME_API_BASE=/runtime-api
# VITE_LEAN_API_BASE=/lean-api
