# Copy this file to .env for local development. Never commit .env.
NACOS_SERVER=localhost:8848

# Secrets are process environment variables, not Nacos configuration values.
DUNE_API_KEY=replace_with_dune_api_key
ETHERSCAN_API_KEY=replace_with_key_1,replace_with_key_2

# Same private token as cloud-service; generate your own value (24+ characters).
CONTRACT_IMPORT_TOKEN=
# Optional output directory. cloud-service CONTRACT_IMPORT_ROOT must point to
# the same directory, visible at the same absolute path to both processes.
DISCOVERY_DATA_DIR=./data
