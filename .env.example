# ContractSearch environment template.
# Copy to a private file and fill in real values. Never commit a filled copy.
#
#   cp .env.example .env
#
# Most Java services read these through Spring's ${VAR:default} placeholders.
# The Node runtimes and the Python discovery service read them from the process
# environment (or their own .env file when run locally).

# ---------------------------------------------------------------------------
# Shared security
# ---------------------------------------------------------------------------
JWT_SECRET=replace_with_random_64_hex
JWT_EXPIRATION_MS=86400000
# Gateway and Agent Service must share the exact same value (>= 24 chars).
AGENT_INTERNAL_TOKEN=replace_with_a_different_random_64_hex

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Zhipu GLM is used by the Agent loop and the standalone AI precheck.
ZHIPU_API_KEY=replace_with_zhipu_api_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DashScope embeddings power the existing semantic search channel.
DASHSCOPE_API_KEY=replace_with_dashscope_api_key

# ---------------------------------------------------------------------------
# Main database (PostgreSQL / ParadeDB with vector + pg_search)
# ---------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/mydatabase
POSTGRESQL_DB_USERNAME=myuser
POSTGRESQL_DB_PASSWORD=replace_with_db_password

# ---------------------------------------------------------------------------
# Service discovery
# ---------------------------------------------------------------------------
# Single-server deployment uses static routing and does not start Nacos.
NACOS_DISCOVERY_ENABLED=false
NACOS_SERVER_ADDR=127.0.0.1:8848
SPRING_CLOUD_NACOS_CONFIG_ENABLED=false
SPRING_CLOUD_NACOS_CONFIG_IMPORT_CHECK_ENABLED=false
CONTRACT_SERVICE_GATEWAY_URI=http://127.0.0.1:18081
AGENT_SERVICE_GATEWAY_URI=http://127.0.0.1:18082

# ---------------------------------------------------------------------------
# Agent service
# ---------------------------------------------------------------------------
AGENT_ENABLED=false
AGENT_ROUTE_ENABLED=false
AGENT_MINI_LOOP_ENABLED=false
AGENT_MIGRATIONS_ENABLED=false
AGENT_PERSISTENCE_ENABLED=false
AGENT_KNOWLEDGE_ENABLED=false
AGENT_MODEL=glm-4.5-air
AGENT_THINKING_ENABLED=false
AGENT_SERVICE_PORT=18082
AGENT_DB_URL=jdbc:postgresql://127.0.0.1:5432/mydatabase
AGENT_DB_USERNAME=myuser
AGENT_DB_PASSWORD=replace_with_db_password
AGENT_PERSISTENCE_DB_URL=jdbc:postgresql://127.0.0.1:5432/mydatabase
AGENT_PERSISTENCE_DB_USERNAME=myuser
AGENT_PERSISTENCE_DB_PASSWORD=replace_with_db_password
AGENT_KNOWLEDGE_DB_URL=jdbc:postgresql://127.0.0.1:5432/mydatabase
AGENT_KNOWLEDGE_DB_USERNAME=myuser
AGENT_KNOWLEDGE_DB_PASSWORD=replace_with_db_password
AGENT_KNOWLEDGE_CORPUS_NAME=contractsearch
AGENT_KNOWLEDGE_CORPUS_VERSION=delivery-stage2-v1
AGENT_CONTRACT_SERVICE_URL=http://127.0.0.1:18081
AGENT_RUNTIME_SERVICE_URL=http://127.0.0.1:19090
AGENT_PROVIDER_TIMEOUT_MS=60000
AGENT_CONTRACT_TIMEOUT_MS=15000
AGENT_COMPILE_TIMEOUT_MS=45000
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_RETRIEVAL_ROUNDS=2

# ---------------------------------------------------------------------------
# Runtime services
# ---------------------------------------------------------------------------
PORT=19090
LEAN_BIN=/path/to/lean
LEAN_TIMEOUT_MS=10000
