# Run: python3 scripts/configure-demo.py
# It creates an ignored .env with fresh random secrets and file mode 0600.
# This template contains placeholders only.
COMPOSE_PROJECT_NAME=contractsearch-demo
DEMO_HTTP_PORT=8080
DEMO_DB_PORT=15432
DEMO_AGENT_PORT=18082
JWT_SECRET=replace_with_random_64_hex
AGENT_INTERNAL_TOKEN=replace_with_random_64_hex
POSTGRESQL_DB_PASSWORD=replace_with_random_64_hex

# Host-run services; Compose supplies internal database/service URLs.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:15432/contractsearch_demo
POSTGRESQL_DB_USERNAME=contractsearch
NACOS_DISCOVERY_ENABLED=false
SPRING_CLOUD_NACOS_CONFIG_ENABLED=false
SPRING_CLOUD_NACOS_CONFIG_IMPORT_CHECK_ENABLED=false
CONTRACT_SERVICE_GATEWAY_URI=http://127.0.0.1:18081
AGENT_SERVICE_GATEWAY_URI=http://127.0.0.1:18082
CONTRACT_SERVICE_HOST=127.0.0.1
GATEWAY_HOST=127.0.0.1
AGENT_SERVICE_HOST=127.0.0.1

# Basic mode does not call model providers. Set keys only in your private .env.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DASHSCOPE_API_KEY=
AGENT_ENABLED=false
AGENT_ROUTE_ENABLED=false
AGENT_MINI_LOOP_ENABLED=false
AGENT_MIGRATIONS_ENABLED=false
AGENT_PERSISTENCE_ENABLED=false
AGENT_KNOWLEDGE_ENABLED=false
AGENT_MODEL=glm-4.5-air
AGENT_SERVICE_PORT=18082
AGENT_DB_URL=jdbc:postgresql://127.0.0.1:15432/contractsearch_demo
AGENT_DB_USERNAME=contractsearch
AGENT_DB_PASSWORD=replace_with_same_database_password
AGENT_KNOWLEDGE_CORPUS_NAME=contractsearch
AGENT_KNOWLEDGE_CORPUS_VERSION=demo-v1
AGENT_CONTRACT_SERVICE_URL=http://127.0.0.1:18081
AGENT_RUNTIME_SERVICE_URL=http://127.0.0.1:19090
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_RETRIEVAL_ROUNDS=2

RUNTIME_PORT=19090
RUNTIME_HOST=127.0.0.1
LEAN_PORT=19100
LEAN_HOST=127.0.0.1
LEAN_BIN=lean
LEAN_TIMEOUT_MS=10000

# Optional offline import; both values must be explicitly configured to enable it.
CONTRACT_IMPORT_TOKEN=
CONTRACT_IMPORT_ROOT=
